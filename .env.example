# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------
PROJECT_ROOT=C:/src/rltm_bi_pltfrm

# -----------------------------------------------------------------------------
# Shared Docker image names
# -----------------------------------------------------------------------------
RLTM_PYTHON_BASE_IMAGE=rltm-python-base:local
RLTM_SPARK_BASE_IMAGE=rltm-spark-base:local
RLTM_AIRFLOW_BASE_IMAGE=rltm-airflow-base:local

RLTM_SPARK_IMAGE=rltm-spark:local
RLTM_AIRFLOW_IMAGE=rltm-airflow:local
RLTM_JUPYTER_IMAGE=rltm-jupyter:local
RLTM_DASHBOARD_API_IMAGE=rltm-dashboard-api:local
RLTM_COLLECTOR_IMAGE=rltm-collector:local
RLTM_WEB_IMAGE=rltm-web:local

# -----------------------------------------------------------------------------
# MinIO / S3-compatible storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# PostgreSQL warehouse
# -----------------------------------------------------------------------------
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse

# ---------------------------------------------------------------------------
# Control / runtime database
# ---------------------------------------------------------------------------
CONTROL_DB_ENABLED=true
CONTROL_DB_HOST=postgres-warehouse
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=warehouse
CONTROL_DB_USER=warehouse
CONTROL_DB_PASSWORD=warehouse
CONTROL_DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Airflow metadata database
# -----------------------------------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# -----------------------------------------------------------------------------
# Airflow local admin
# -----------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_UID=50000

AIRFLOW_API_BASE=http://airflow-api-server:8080
AIRFLOW_API_JWT_SECRET=replace-with-a-long-random-local-dev-jwt-secret
AIRFLOW_API_SECRET_KEY=replace-with-a-long-random-local-dev-api-secret

# -----------------------------------------------------------------------------
# Spark
# -----------------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_ENABLE_IVY_PACKAGES=false

# -----------------------------------------------------------------------------
# Kafka / collector
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_TOPIC=user_events
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
COLLECTOR_ALLOWED_ORIGINS=http://localhost:8091,http://127.0.0.1:8091

# -----------------------------------------------------------------------------
# Demo web app
# -----------------------------------------------------------------------------
WEB_COLLECTOR_URL=http://collector:8000/collect
WEB_PUBLIC_COLLECTOR_URL=http://localhost:8000/collect

# -----------------------------------------------------------------------------
# External API secrets
# -----------------------------------------------------------------------------
METALPRICE_API_KEY=replace-with-your-metalprice-api-key
OPENWEATHER_API_KEY=replace-with-your-openweather-api-key

# -----------------------------------------------------------------------------
# Ecommerce SQL Server JDBC source
# These names must match configs/connections/jdbc_connections.json
# -----------------------------------------------------------------------------
ECOM_SQLSERVER_HOST=host.docker.internal
ECOM_SQLSERVER_PORT=1433
ECOM_SQLSERVER_DB=replace-with-database-name
ECOM_SQLSERVER_USER=replace-with-sqlserver-user
ECOM_SQLSERVER_PASSWORD=replace-with-sqlserver-password


# -----------------------------------------------------------------------------
# Ecommerce PostgreSQL JDBC source
# These names must match configs/connections/jdbc_connections.json
# -----------------------------------------------------------------------------
ECOM_POSTGRES_HOST=host.docker.internal
ECOM_POSTGRES_PORT=5432
ECOM_POSTGRES_DB=replace-with-postgres-database-name
ECOM_POSTGRES_USER=replace-with-postgres-user
ECOM_POSTGRES_PASSWORD=replace-with-postgres-password

# -----------------------------------------------------------------------------
# Ecommerce MySQL JDBC source
# These names must match configs/connections/jdbc_connections.json
# -----------------------------------------------------------------------------
ECOM_MYSQL_HOST=host.docker.internal
ECOM_MYSQL_PORT=3306
ECOM_MYSQL_DB=replace-with-mysql-database-name
ECOM_MYSQL_USER=replace-with-mysql-user
ECOM_MYSQL_PASSWORD=replace-with-mysql-password




# Never use these default values in production.
# Dashboard runtime environment
APP_ENV=dev

# Must be changed in production
DASHBOARD_SECRET_KEY=dev-secret-change-me
DASHBOARD_TOKEN_EXPIRE_MINUTES=1440

# Local development only
DASHBOARD_DEV_ADMIN_USERNAME=admin
DASHBOARD_DEV_ADMIN_PASSWORD=admin
DASHBOARD_DEV_ADMIN_EMAIL=admin@example.com
DASHBOARD_DEV_ADMIN_ROLE=admin

# Airflow API
AIRFLOW_API_BASE=http://airflow-api-server:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Catalog onboarding DAG
CONTROL_ONBOARDING_DAG_ID=control_plane_onboarding
