{
  "pipelines": [
    {
      "name": "gold_price_pipeline",
      "enabled": true,
      "description": "API-driven gold price Bronze/Silver/Gold batch pipeline",
      "domain": "gold_price",
      "source_type": "api",
      "dag": {
        "schedule": null,
        "catchup": false,
        "max_active_runs": 1,
        "start_date": "2026-01-01T00:00:00+00:00",
        "tags": [
          "gold_price",
          "batch",
          "api",
          "spark",
          "catalog_driven"
        ],
        "default_args": {
          "owner": "admin",
          "retries": 0,
          "retry_delay_minutes": 1
        }
      },
      "jobs": [
        {
          "name": "gold_price_ingest",
          "enabled": true,
          "job_type": "generic_api_to_bronze",
          "source_type": "api",
          "dependencies": [],
          "execution_timeout_minutes": 10,
          "retries": 0,
          "retry_delay_minutes": 1,
          "tags": [
            "gold_price",
            "api",
            "bronze"
          ],
          "spec": {
            "load_type": "event",
            "strategy": "append_event",
            "source": {
              "base_url": "https://api.metalpriceapi.com/v1/latest",
              "method": "GET",
              "timeout_seconds": 20
            },
            "auth": {
              "type": "query_param",
              "param_name": "api_key",
              "secret_env": "METALPRICE_API_KEY"
            },
            "request": {
              "query_params": {
                "base": "XAU",
                "currencies": "USD"
              },
              "headers": {},
              "body": null
            },
            "response": {
              "format": "json",
              "root_path": "$",
              "record_mode": "single_object"
            },
            "validation": {
              "required_paths": [
                "$.success",
                "$.timestamp",
                "$.rates.USD"
              ],
              "rules": [
                {
                  "type": "equals",
                  "path": "$.success",
                  "value": true
                }
              ]
            },
            "schema": [
              "event_id string not null",
              "source_name string not null",
              "symbol string null",
              "currency string null",
              "source_event_ts timestamp null",
              "ingestion_ts timestamp not null",
              "price_usd double null",
              "payload_json string not null",
              "api_status string not null"
            ],
            "mapping": {
              "source_name": {
                "source": "constant",
                "value": "metalpriceapi"
              },
              "symbol": {
                "source": "constant",
                "value": "XAU"
              },
              "currency": {
                "source": "constant",
                "value": "USD"
              },
              "source_event_ts": {
                "source": "json",
                "path": "$.timestamp",
                "cast": "unix_ts"
              },
              "price_usd": {
                "source": "json",
                "path": "$.rates.USD",
                "cast": "double"
              },
              "ingestion_ts": {
                "source": "runtime",
                "value": "current_utc"
              },
              "payload_json": {
                "source": "runtime",
                "value": "raw_payload_json"
              },
              "api_status": {
                "source": "constant",
                "value": "success"
              }
            },
            "bronze_write": {
              "target_path": "s3a://lakehouse/bronze/gold_price_events",
              "mode": "append",
              "partition_by": [
                "ingest_year",
                "ingest_month",
                "ingest_day",
                "ingest_hour"
              ],
              "include_raw_payload": true
            },
            "runtime_policy": {
              "max_retries": 3,
              "backoff_seconds": 10
            },
            "spark": {
              "master": null,
              "packages": [],
              "conf": {}
            }
          },
          "layer": "bronze"
        },
        {
          "name": "gold_price_silver",
          "enabled": true,
          "job_type": "generic_bronze_to_silver",
          "source_type": "api",
          "dependencies": [
            "gold_price_ingest"
          ],
          "execution_timeout_minutes": 10,
          "retries": 0,
          "retry_delay_minutes": 1,
          "tags": [
            "gold_price",
            "silver"
          ],
          "spec": {
            "source": {
              "path": "s3a://lakehouse/bronze/gold_price_events",
              "format": "delta"
            },
            "target": {
              "path": "s3a://lakehouse/silver/gold_price_ticks_clean",
              "format": "delta",
              "mode": "merge",
              "merge_keys": [
                "event_id"
              ],
              "partition_by": [
                "processing_date"
              ]
            },
            "select_map": {
              "event_id": "event_id",
              "symbol": "symbol",
              "source_name": "source_name",
              "event_ts_utc": "source_event_ts",
              "ingestion_ts": "ingestion_ts",
              "price_usd": "price_usd",
              "currency": "currency"
            },
            "filters": [
              {
                "type": "equals",
                "field": "api_status",
                "value": "success"
              }
            ],
            "derived_fields": {
              "processing_date": {
                "kind": "sql",
                "expr": "to_date(ingestion_ts)"
              }
            },
            "quality_rules": [
              {
                "type": "not_null",
                "field": "event_id"
              },
              {
                "type": "not_null",
                "field": "event_ts_utc"
              },
              {
                "type": "not_null",
                "field": "price_usd"
              },
              {
                "type": "greater_than",
                "field": "price_usd",
                "value": 0
              }
            ],
            "dedupe": {
              "key_columns": [
                "event_id"
              ],
              "order_by": [
                "ingestion_ts desc"
              ]
            },
            "spark": {
              "master": null,
              "packages": [],
              "conf": {}
            },
            "incremental": {
              "enabled": true,
              "strategy": "target_max_watermark",
              "watermark_column": "ingestion_ts",
              "lookback_minutes": 0
            }
          },
          "layer": "silver"
        },
        {
          "name": "gold_price_gold",
          "enabled": true,
          "job_type": "generic_silver_to_gold",
          "source_type": "api",
          "dependencies": [
            "gold_price_silver"
          ],
          "execution_timeout_minutes": 10,
          "retries": 0,
          "retry_delay_minutes": 1,
          "tags": [
            "gold_price",
            "gold"
          ],
          "spec": {
            "source": {
              "path": "s3a://lakehouse/silver/gold_price_ticks_clean",
              "format": "delta"
            },
            "target": {
              "path": "s3a://lakehouse/gold/gold_price_curated",
              "format": "delta",
              "mode": "merge",
              "merge_keys": [
                "event_id"
              ],
              "partition_by": [
                "trade_date"
              ]
            },
            "select_map": {
              "event_id": "event_id",
              "symbol": "symbol",
              "source_name": "source_name",
              "currency": "currency",
              "event_ts": "event_ts_utc",
              "ingestion_ts": "ingestion_ts",
              "price_usd": "price_usd"
            },
            "filters": [],
            "derived_fields": {
              "trade_date": {
                "kind": "sql",
                "expr": "to_date(event_ts)"
              },
              "price_bucket": {
                "kind": "sql",
                "expr": "case when price_usd < 2500 then 'low' when price_usd < 3500 then 'mid' else 'high' end"
              }
            },
            "quality_rules": [
              {
                "type": "not_null",
                "field": "event_id"
              },
              {
                "type": "not_null",
                "field": "event_ts"
              },
              {
                "type": "not_null",
                "field": "ingestion_ts"
              },
              {
                "type": "not_null",
                "field": "price_usd"
              },
              {
                "type": "greater_than",
                "field": "price_usd",
                "value": 0
              }
            ],
            "dedupe": {
              "key_columns": [
                "event_id"
              ],
              "order_by": [
                "ingestion_ts desc"
              ]
            },
            "spark": {
              "master": null,
              "packages": [],
              "conf": {}
            },
            "incremental": {
              "enabled": true,
              "strategy": "target_max_watermark",
              "watermark_column": "ingestion_ts",
              "lookback_minutes": 0
            }
          },
          "layer": "gold"
        }
      ]
    },
