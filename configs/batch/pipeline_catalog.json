    {
      "name": "weather_forecast_pipeline",
      "description": "API-driven weather forecast Bronze/Silver/Gold batch pipeline",
      "enabled": true,
      "dag": {
        "schedule": null,
        "start_date": "2026-01-01T00:00:00+00:00",
        "catchup": false,
        "max_active_runs": 1,
        "default_args": {
          "owner": "admin",
          "retries": 0,
          "retry_delay_minutes": 1
        },
        "tags": [
          "weather",
          "api",
          "batch",
          "spark",
          "catalog_driven",
          "catalog_managed"
        ]
      },
      "domain": "weather",
      "source_type": "api",
      "jobs": [
        {
          "name": "weather_forecast_ingest",
          "job_type": "generic_api_to_bronze",
          "source_type": "api",
          "enabled": true,
          "dependencies": [],
          "retries": 0,
          "retry_delay_minutes": 1,
          "execution_timeout_minutes": 10,
          "spec": {
            "load_type": "event",
            "strategy": "append_event",
            "source": {
              "base_url": "https://api.open-meteo.com/v1/forecast",
              "method": "GET",
              "timeout_seconds": 20
            },
            "auth": {
              "type": "none",
              "secret_env": ""
            },
            "request": {
              "query_params": {
                "latitude": "51.5085",
                "longitude": "-0.1257",
                "timezone": "Europe/London",
                "forecast_days": "1",
                "hourly": "temperature_2m,relative_humidity_2m,precipitation,weather_code,wind_speed_10m"
              },
              "headers": {},
              "body": null
            },
            "response": {
              "format": "json",
              "root_path": "$",
              "record_mode": "single_object"
            },
            "validation": {
              "required_paths": [
                "$.latitude",
                "$.longitude",
                "$.timezone",
                "$.hourly"
              ],
              "rules": []
            },
            "mapping": {},
            "schema": [],
            "bronze_write": {
              "target_path": "s3a://lakehouse/bronze/weather_forecast_events",
              "mode": "append",
              "partition_by": [
                "ingest_year",
                "ingest_month",
                "ingest_day",
                "ingest_hour"
              ],
              "include_raw_payload": true
            },
            "runtime_policy": {
              "max_retries": 3,
              "backoff_seconds": 10
            },
            "spark": {
              "master": null,
              "packages": [],
              "conf": {}
            },
            "read_policy": {
              "mode": "snapshot",
              "strategy": "api_request"
            },
            "write_policy": {
              "mode": "append",
              "target_path": "s3a://lakehouse/bronze/weather_forecast_events",
              "format": "delta",
              "merge_keys": [],
              "partition_by": [
                "ingest_year",
                "ingest_month",
                "ingest_day",
                "ingest_hour"
              ]
            }
          },
          "tags": [
            "weather",
            "bronze",
            "api"
          ],
          "layer": "bronze"
        },
        {
          "name": "weather_forecast_silver",
          "enabled": true,
          "layer": "silver",
          "job_type": "generic_bronze_to_silver",
          "source_type": "api",
          "dependencies": [
            "weather_forecast_ingest"
          ],
          "retries": 0,
          "retry_delay_minutes": 1,
          "execution_timeout_minutes": 10,
          "tags": [
            "weather",
            "silver",
            "api"
          ],
          "spec": {
            "views": [
              {
                "alias": "bronze",
                "path": "s3a://lakehouse/bronze/weather_forecast_events",
                "format": "delta"
              }
            ],
            "incremental": {
              "enabled": true,
              "strategy": "target_max_watermark",
              "source_alias": "bronze",
              "watermark_column": "ingestion_ts",
              "lookback_minutes": 0
            },
            "sql": {
              "query": "WITH root AS (SELECT event_id AS bronze_event_id, source_name, ingestion_ts, source_event_ts, api_status, from_json(payload_json, 'STRUCT<latitude:DOUBLE,longitude:DOUBLE,timezone:STRING,hourly:STRING>') AS j FROM bronze WHERE api_status = '200' OR api_status = 'success'), parsed AS (SELECT bronze_event_id, source_name, ingestion_ts, source_event_ts, api_status, j.latitude AS latitude, j.longitude AS longitude, j.timezone AS timezone, from_json(j.hourly, 'STRUCT<time:ARRAY<STRING>,temperature_2m:ARRAY<DOUBLE>,relative_humidity_2m:ARRAY<BIGINT>,precipitation:ARRAY<DOUBLE>,weather_code:ARRAY<BIGINT>,wind_speed_10m:ARRAY<DOUBLE>>') AS h FROM root), exploded AS (SELECT sha2(concat_ws('|', source_name, cast(latitude as string), cast(longitude as string), timezone, x.time), 256) AS weather_forecast_hour_id, bronze_event_id, source_name, latitude, longitude, timezone, to_timestamp(x.time) AS forecast_ts, ingestion_ts, source_event_ts, api_status, x.temperature_2m AS temperature_2m, x.relative_humidity_2m AS relative_humidity_2m, x.precipitation AS precipitation, x.weather_code AS weather_code, x.wind_speed_10m AS wind_speed_10m, to_date(ingestion_ts) AS processing_date FROM parsed LATERAL VIEW explode(arrays_zip(h.time, h.temperature_2m, h.relative_humidity_2m, h.precipitation, h.weather_code, h.wind_speed_10m)) e AS x) SELECT * FROM exploded"
            },
            "target": {
              "path": "s3a://lakehouse/silver/weather_forecast_clean",
              "format": "delta",
              "mode": "merge",
              "merge_keys": [
                "weather_forecast_hour_id"
              ],
              "partition_by": [
                "processing_date"
              ]
            },
            "quality_rules": [
              {
                "type": "not_null",
                "field": "weather_forecast_hour_id"
              },
              {
                "type": "not_null",
                "field": "forecast_ts"
              }
            ],
            "dedupe": {
              "key_columns": [
                "weather_forecast_hour_id"
              ],
              "order_by": [
                "ingestion_ts desc"
              ]
            },
            "filters": [],
            "spark": {
              "master": null,
              "packages": [],
              "conf": {}
            },
            "source": {
              "path": "s3a://lakehouse/bronze/weather_forecast_events",
              "format": "delta"
            },
            "read_policy": {
              "mode": "incremental",
              "strategy": "target_max_watermark",
              "source_alias": "bronze",
              "watermark_column": "ingestion_ts",
              "lookback_minutes": 0
            },
            "write_policy": {
              "mode": "merge",
              "target_path": "s3a://lakehouse/silver/weather_forecast_clean",
              "format": "delta",
              "merge_keys": [
                "weather_forecast_hour_id"
              ],
              "partition_by": [
                "processing_date"
              ]
            }
          }
        },
        {
          "name": "weather_forecast_gold",
          "enabled": true,
          "layer": "gold",
          "job_type": "generic_silver_to_gold",
          "source_type": "api",
          "dependencies": [
            "weather_forecast_silver"
          ],
          "retries": 0,
          "retry_delay_minutes": 1,
          "execution_timeout_minutes": 10,
          "tags": [
            "weather",
            "gold",
            "api"
          ],
          "spec": {
            "views": [
              {
                "alias": "weather",
                "path": "s3a://lakehouse/silver/weather_forecast_clean",
                "format": "delta"
              }
            ],
            "sql": {
              "query": "SELECT to_date(forecast_ts) AS forecast_date, latitude, longitude, timezone, avg(temperature_2m) AS avg_temperature_2m, min(temperature_2m) AS min_temperature_2m, max(temperature_2m) AS max_temperature_2m, avg(relative_humidity_2m) AS avg_relative_humidity_2m, sum(coalesce(precipitation, 0.0)) AS total_precipitation, max(wind_speed_10m) AS max_wind_speed_10m, max(ingestion_ts) AS ingestion_ts, current_timestamp() AS curated_at FROM weather GROUP BY to_date(forecast_ts), latitude, longitude, timezone"
            },
            "target": {
              "path": "s3a://lakehouse/gold/weather_forecast_curated",
              "format": "delta",
              "mode": "merge",
              "merge_keys": [
                "forecast_date",
                "latitude",
                "longitude",
                "timezone"
              ],
              "partition_by": [
                "forecast_date"
              ]
            },
            "quality_rules": [
              {
                "type": "not_null",
                "field": "forecast_date"
              }
            ],
            "dedupe": {
              "key_columns": [
                "forecast_date",
                "latitude",
                "longitude",
                "timezone"
              ],
              "order_by": [
                "curated_at desc"
              ]
            },
            "filters": [],
            "spark": {
              "master": null,
              "packages": [],
              "conf": {}
            },
            "source": {
              "path": "s3a://lakehouse/silver/weather_forecast_clean",
              "format": "delta"
            },
            "read_policy": {
              "mode": "full",
              "strategy": "full_refresh"
            },
            "write_policy": {
              "mode": "merge",
              "target_path": "s3a://lakehouse/gold/weather_forecast_curated",
              "format": "delta",
              "merge_keys": [
                "forecast_date",
                "latitude",
                "longitude",
                "timezone"
              ],
              "partition_by": [
                "forecast_date"
              ]
            }
          }
        }
      ]
    }
  ]
}
