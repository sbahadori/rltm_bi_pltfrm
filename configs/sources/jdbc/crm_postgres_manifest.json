{
  "version": 1,
  "source_id": "crm_postgres",
  "source_type": "jdbc",
  "connection_ref": "crm_postgres",
  "enabled": true,

  "defaults": {
    "read_mode": "incremental",
    "watermark_column": "updated_at",
    "watermark_type": "timestamp",
    "watermark_default_value": "1970-01-01 00:00:00",

    "num_partitions": 4,
    "fetch_size": 10000,

    "bronze_format": "delta",
    "bronze_mode": "append",
    "target_path_template": "s3a://lakehouse/bronze/{source_id}/{table_id}",

    "partition_by": [
      "ingest_year",
      "ingest_month",
      "ingest_day"
    ],

    "add_ingestion_metadata": true,
    "add_row_hash": true
  },

  "tables": [
    {
      "table_id": "orders",
      "enabled": true,
      "source_table": "public.orders",
      "primary_key": ["order_id"],
      "columns": [
        "order_id",
        "customer_id",
        "order_status",
        "total_amount",
        "updated_at",
        "created_at"
      ],
      "watermark_column": "updated_at",
      "partition_column": "order_id",
      "num_partitions": 8
    },

    {
      "table_id": "customers",
      "enabled": true,
      "source_table": "public.customers",
      "primary_key": ["customer_id"],
      "columns": [
        "customer_id",
        "email",
        "phone",
        "status",
        "updated_at",
        "created_at"
      ],
      "watermark_column": "updated_at",
      "partition_column": "customer_id",
      "num_partitions": 4
    },

    {
      "table_id": "products",
      "enabled": true,
      "source_table": "public.products",
      "primary_key": ["product_id"],
      "columns": [
        "product_id",
        "sku",
        "product_name",
        "category_id",
        "price",
        "updated_at"
      ],
      "watermark_column": "updated_at",
      "partition_column": "product_id",
      "num_partitions": 4
    }
  ]
}