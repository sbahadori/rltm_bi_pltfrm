{
  "streams": [
    {
      "name": "clickstream_user_events",
      "enabled": true,
      "source": {
        "type": "kafka",
        "bootstrap_servers": "kafka:19092",
        "topic": "user_events",
        "starting_offsets": "latest",
        "fail_on_data_loss": false,
        "startup_wait_seconds": 60,
        "metadata_retry_interval_seconds": 5
      },
      "bronze": {
        "engine": "generic_kafka_to_bronze",
        "app_name": "bronze_clickstream_user_events",
        "path": "s3a://lakehouse/bronze_delta/user_events",
        "checkpoint_dir": "/tmp/checkpoints/bronze_clickstream_user_events",
        "heartbeat_file": "/tmp/health/bronze_clickstream_user_events.json",
        "trigger_interval": "15 seconds",
        "partition_by": [
          "event_date"
        ],
        "derived_fields": {
          "event_type": {
            "kind": "json",
            "path": "$.event_type"
          },
          "anonymous_id": {
            "kind": "json",
            "path": "$.anonymous_id"
          },
          "session_id": {
            "kind": "json",
            "path": "$.session_id"
          },
          "event_ts": {
            "kind": "json_timestamp",
            "path": "$.event_ts"
          },
          "event_date": {
            "kind": "sql",
            "expr": "coalesce(to_date(event_ts), to_date(kafka_timestamp))"
          }
        }
      },
      "silver": {
        "engine": "generic_bronze_to_silver",
        "app_name": "silver_clickstream_user_events",
        "bronze_path": "s3a://lakehouse/bronze_delta/user_events",
        "path": "s3a://lakehouse/silver_delta/user_events_clean",
        "quarantine_path": "s3a://lakehouse/silver_delta/user_events_quarantine",
        "checkpoint_dir": "/tmp/checkpoints/silver_clickstream_user_events",
        "heartbeat_file": "/tmp/health/silver_clickstream_user_events.json",
        "trigger_interval": "30 seconds",
        "field_map": {
          "event_id": {
            "path": "$.event_id",
            "cast": "string"
          },
          "event_ts": {
            "path": "$.event_ts",
            "cast": "timestamp"
          },
          "event_type": {
            "path": "$.event_type",
            "cast": "string"
          },
          "source": {
            "path": "$.source",
            "cast": "string"
          },
          "user_id": {
            "path": "$.user_id",
            "cast": "string"
          },
          "anonymous_id": {
            "path": "$.anonymous_id",
            "cast": "string"
          },
          "session_id": {
            "path": "$.session_id",
            "cast": "string"
          },
          "page_url": {
            "path": "$.page_url",
            "cast": "string"
          },
          "item_id": {
            "path": "$.properties.item_id",
            "cast": "string"
          },
          "item_title": {
            "path": "$.properties.item_title",
            "cast": "string"
          },
          "backend_event_name": {
            "path": "$.properties.backend_event_name",
            "cast": "string"
          },
          "message": {
            "path": "$.properties.message",
            "cast": "string"
          },
          "search_query": {
            "path": "$.properties.search_query",
            "cast": "string"
          },
          "results_count": {
            "path": "$.properties.results_count",
            "cast": "long"
          }
        },
        "required_fields": [
          "event_type",
          "event_date"
        ],
        "identity_keys": [
          "event_id",
          "user_id",
          "anonymous_id",
          "session_id"
        ],
        "computed_fields": {
          "event_date": {
            "kind": "sql",
            "expr": "coalesce(to_date(event_ts), to_date(kafka_timestamp))"
          },
          "canonical_user_key": {
            "kind": "sql",
            "expr": "coalesce(user_id, anonymous_id)"
          }
        },
        "transform_plugin": null
      },
      "restart_policy": {
        "max_retries": 10,
        "backoff_seconds": 10
      }
    }
  ]
}